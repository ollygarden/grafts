{#- The Prometheus compatibility table, consumed by internal/promcompat.

    Every fact here comes from `annotations.prometheus` in the registry, which
    is what keeps the OTel shape and the compat shape from drifting: they are
    generated from the same entry in the same pass. -#}
{%- macro prom_type(metric) %}{{ metric.instrument | map_text("prom_types", "no Prometheus type for instrument " ~ metric.instrument) }}{% endmacro -%}
// Code generated by weaver. DO NOT EDIT.
// Source: {{ ctx.schema_url }}

package {{ params.package_name }}

import "{{ params.promcompat_package }}"

// CompatTable is every OTel metric with a Prometheus counterpart. Entries the
// registry marks `emit_prometheus: false` carry no Series: they are surface the
// upstream exporter does not have, or the losing half of a `split` whose compat
// series another entry already owns.
var CompatTable = []promcompat.Entry{
{%- for metric in ctx.metrics %}
{%- set prom = metric.annotations.prometheus %}
	{
		Metric:      "{{ metric.name }}",
		Type:        "{{ prom_type(metric) }}",
		Source:      promcompat.Source{{ prom.compat_source | pascal_case }},
{%- if prom.labels %}
		Labels: map[string]string{
{%- for key, label in prom.labels | items %}
			"{{ key }}": "{{ label }}",
{%- endfor %}
		},
{%- endif %}
{%- if prom.dropped_labels %}
		Dropped: []string{
{%- for label in prom.dropped_labels %}
			"{{ label }}",
{%- endfor %}
		},
{%- endif %}
{%- if prom.series and prom.emit_prometheus != false %}
		Series: []promcompat.Series{
{%- for series in prom.series %}
			{
				Name: "{{ series.name }}",
{%- if series.when %}
				When: map[string]string{
{%- for key, value in series.when | items %}
					"{{ key }}": "{{ value }}",
{%- endfor %}
				},
{%- endif %}
			},
{%- endfor %}
		},
{%- endif %}
	},
{%- endfor %}
}
