{#- The component's own instruments, replacing the hand-written telemetry.go
    the other components in this repository still carry.

    Unlike the scraped metrics, these go through the OTel metric API rather than
    pdata: they describe the Collector's own operation, so they belong on the
    MeterProvider the Collector hands the component.

    Identifiers drop the component prefix -- unlike metrics.go.j2, this file has
    exactly one root namespace, so `pgbouncerreceiver.scrape.errors` becomes
    ScrapeErrors with nothing to collide with. -#}
{%- macro go_name(name) %}{% for seg in name | split(".") %}{% if not loop.first %}{{ seg | pascal_case | acronym }}{% endif %}{% endfor %}{% endmacro -%}
{%- macro go_param(key) %}{% for seg in key | split(".") %}{% if loop.first %}{{ seg }}{% else %}{{ seg | pascal_case | acronym }}{% endif %}{% endfor %}{% endmacro -%}
{%- macro instrument(metric) %}{{ metric.annotations.code_generation.metric_value_type | map_text("otel_value_prefix", "metric " ~ metric.name ~ " has no annotations.code_generation.metric_value_type") }}{{ metric.instrument | map_text("otel_instrument", "unsupported instrument " ~ metric.instrument) }}{% endmacro -%}
{%- macro attr_params(metric) %}{% for attr in metric.attributes %}, {{ go_param(attr.key) }} string{% endfor %}{% endmacro -%}
// Code generated by weaver. DO NOT EDIT.
// Source: {{ ctx.schema_url }}

package {{ params.package_name }}

import (
	"context"
	"fmt"

	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/metric"
)

// SelfTelemetry holds the instruments {{ ctx.component }} reports about its own
// operation, as distinct from the metrics it reports about the system it
// monitors.
//
// Declaring both in one registry is what makes `weaver registry check` a
// complete gate: a component cannot quietly grow an undeclared instrument on
// either side.
type SelfTelemetry struct {
{%- for metric in ctx.metrics %}
	// {{ go_name(metric.name) }} reports {{ metric.name }}: {{ metric.brief | trim }}
	{{ go_name(metric.name) }} metric.{{ instrument(metric) }}
{%- endfor %}
}

// NewSelfTelemetry creates the component's instruments on the provider the
// Collector supplies. An instrument that cannot be created is returned as an
// error rather than left nil, so a mistake surfaces at startup instead of as a
// panic on the first scrape.
func NewSelfTelemetry(provider metric.MeterProvider, scopeName string) (*SelfTelemetry, error) {
	meter := provider.Meter(scopeName)
	t := &SelfTelemetry{}

	var err error
{%- for metric in ctx.metrics %}
	if t.{{ go_name(metric.name) }}, err = meter.{{ instrument(metric) }}(
		"{{ metric.name }}",
		metric.WithDescription({{ metric.brief | trim | tojson }}),
		metric.WithUnit("{{ metric.unit }}"),
	); err != nil {
		return nil, fmt.Errorf("creating {{ metric.name }}: %w", err)
	}
{%- endfor %}

	return t, nil
}
{% for metric in ctx.metrics %}
// Record{{ go_name(metric.name) }} records {{ metric.name }}.
//
{{ metric.brief | trim | comment(format="go") }}
{%- if metric.note %}
//
{{ metric.note | trim | comment(format="go") }}
{%- endif %}
func (t *SelfTelemetry) Record{{ go_name(metric.name) }}(ctx context.Context, value {{ metric.annotations.code_generation.metric_value_type | map_text("value_types", "no value type for " ~ metric.name) }}{{ attr_params(metric) }}) {
	t.{{ go_name(metric.name) }}.{{ metric.instrument | map_text("otel_method", "unsupported instrument " ~ metric.instrument) }}(ctx, value{% if metric.attributes %}, metric.WithAttributes(
{%- for attr in metric.attributes %}
		attribute.String("{{ attr.key }}", {{ go_param(attr.key) }}),
{%- endfor %}
	){% endif %})
}
{% endfor %}
