{#- The scrape-side builder: telemetry about the monitored system, built as
    pdata rather than through the OTel metric API, because a receiver hands the
    Collector pipeline a pmetric.Metrics rather than recording on instruments.

    Unlike trellis's template, which emits instrument constructors, this one
    constructs datapoints, gates each metric on config, and exposes a typed
    Record method per metric.

    Identifiers keep every segment of the metric name. trellis drops the root
    because one registry owns one prefix; a grafts registry is mostly refs to
    upstream, so dropping it would collide -- db.client.connection.count and
    pgbouncer.client.connection.count both become ClientConnectionCount. -#}
{%- macro go_name(name) %}{% for seg in name | split(".") %}{{ seg | pascal_case | acronym }}{% endfor %}{% endmacro -%}
{%- macro go_param(key) %}{% for seg in key | split(".") %}{% if loop.first %}{{ seg }}{% else %}{{ seg | pascal_case | acronym }}{% endif %}{% endfor %}{% endmacro -%}
{#- An enum attribute carries an object type rather than a scalar one. Its
    members are strings, and the component may also record a value the upstream
    convention does not list, so the parameter stays a plain string with the
    declared values available as constants above. -#}
{%- macro go_type(attr) %}{% if attr.type.members %}string{% else %}{{ attr.type | map_text("go_types", "unsupported attribute type for " ~ attr.key) }}{% endif %}{% endmacro -%}
{%- macro pdata_setter(attr) %}{% if attr.type.members %}PutStr{% else %}{{ attr.type | map_text("pdata_setters", "unsupported attribute type for " ~ attr.key) }}{% endif %}{% endmacro -%}
{%- macro attrs_type(metric) %}{{ go_name(metric.name) }}Attributes{% endmacro -%}
{#- Attributes are passed as a struct rather than positionally. Several metrics
    here take five or more same-typed strings, where a transposed pair compiles
    cleanly and only shows up as a mislabelled datapoint; named fields make that
    a compile error instead. -#}
{%- macro attr_params(metric) %}{% if metric.attributes %}, attrs {{ attrs_type(metric) }}{% endif %}{% endmacro -%}
{%- macro value_type(metric) %}{{ metric.annotations.code_generation.metric_value_type | map_text("value_types", "metric " ~ metric.name ~ " has no annotations.code_generation.metric_value_type") }}{% endmacro -%}
{%- macro accessor(metric) %}{{ metric.instrument | map_text("datapoint_accessor", "instrument " ~ metric.instrument ~ " on " ~ metric.name ~ " cannot be built as pdata here") }}{% endmacro -%}
// Code generated by weaver. DO NOT EDIT.
// Source: {{ ctx.schema_url }}

// Package {{ params.package_name }} builds the metrics {{ ctx.component }} reports about the
// system it monitors.
//
// The registry behind the schema URL above is the only place these are
// defined. Editing this file by hand puts the code and the parity report out of
// step, which is the drift the registry exists to remove.
package {{ params.package_name }}

import (
	"go.opentelemetry.io/collector/pdata/pcommon"
	"go.opentelemetry.io/collector/pdata/pmetric"
)

// Attribute values this registry declares. An attribute whose upstream
// convention defines fewer values than the monitored system reports is an open
// enum: the component may record a value not listed here, and says so in the
// metric's note.
{% for attr in ctx.metrics | map(attribute="attributes") | flatten | unique(attribute="key") | sort(attribute="key") %}
{%- if attr.type.members %}
const (
{%- for member in attr.type.members %}
	// Attribute{{ go_name(attr.key) }}{{ member.id | pascal_case | acronym }} is `{{ member.value }}` for {{ attr.key }}.
	Attribute{{ go_name(attr.key) }}{{ member.id | pascal_case | acronym }} = "{{ member.value }}"
{%- endfor %}
)
{% endif %}
{%- endfor %}

// MetricConfig gates a single metric.
type MetricConfig struct {
	Enabled bool `mapstructure:"enabled"`
}

// MetricsConfig gates every metric this component can report. A metric that is
// disabled records nothing and is absent from the output entirely, rather than
// being emitted empty.
type MetricsConfig struct {
{%- for metric in ctx.metrics %}
	{{ go_name(metric.name) }} MetricConfig `mapstructure:"{{ metric.name }}"`
{%- endfor %}
}

// DefaultMetricsConfig enables every metric the registry marks `recommended` or
// `required`, and leaves `opt_in` metrics off.
func DefaultMetricsConfig() MetricsConfig {
	return MetricsConfig{
{%- for metric in ctx.metrics %}
		{{ go_name(metric.name) }}: MetricConfig{Enabled: {{ "false" if metric.requirement_level == "opt_in" else "true" }}},
{%- endfor %}
	}
}
{% for metric in ctx.metrics %}
{%- set acc = accessor(metric) %}
{%- set vt = value_type(metric) %}
type metric{{ go_name(metric.name) }} struct {
	data     pmetric.Metric
	capacity int
	config   MetricConfig
}

func (m *metric{{ go_name(metric.name) }}) init() {
	m.data.SetName("{{ metric.name }}")
	m.data.SetDescription({{ metric.brief | trim | tojson }})
	m.data.SetUnit("{{ metric.unit }}")
	m.data.SetEmpty{{ acc }}()
{%- if metric.instrument != "gauge" %}
	m.data.{{ acc }}().SetIsMonotonic({{ metric.instrument | map_text("monotonic", "no monotonicity for " ~ metric.instrument) }})
	m.data.{{ acc }}().SetAggregationTemporality(pmetric.AggregationTemporalityCumulative)
{%- endif %}
	m.data.{{ acc }}().DataPoints().EnsureCapacity(m.capacity)
}

{% if metric.attributes %}
// {{ attrs_type(metric) }} carries the attributes of {{ metric.name }}.
type {{ attrs_type(metric) }} struct {
{%- for attr in metric.attributes %}
	// {{ go_name(attr.key) }} is `{{ attr.key }}`.
	{{ go_name(attr.key) }} {{ go_type(attr) }}
{%- endfor %}
}
{% endif %}
func (m *metric{{ go_name(metric.name) }}) record(start, ts pcommon.Timestamp, value {{ vt }}{{ attr_params(metric) }}) {
	if !m.config.Enabled {
		return
	}
	dp := m.data.{{ acc }}().DataPoints().AppendEmpty()
	dp.SetStartTimestamp(start)
	dp.SetTimestamp(ts)
	dp.{{ metric.annotations.code_generation.metric_value_type | map_text("value_setters", "no value setter") }}(value)
{%- for attr in metric.attributes %}
	dp.Attributes().{{ pdata_setter(attr) }}("{{ attr.key }}", attrs.{{ go_name(attr.key) }})
{%- endfor %}
}

func (m *metric{{ go_name(metric.name) }}) emit(ms pmetric.MetricSlice) {
	if !m.config.Enabled || m.data.{{ acc }}().DataPoints().Len() == 0 {
		return
	}
	m.data.MoveTo(ms.AppendEmpty())
	m.init()
}
{% endfor %}
// MetricsBuilder accumulates one scrape's worth of datapoints and hands them
// over as a pmetric.Metrics.
//
// It is not safe for concurrent use: a scraper owns one and drives it from a
// single scrape.
type MetricsBuilder struct {
	config       MetricsConfig
	startTime    pcommon.Timestamp
	scopeName    string
	scopeVersion string
{%- for metric in ctx.metrics %}
	metric{{ go_name(metric.name) }} metric{{ go_name(metric.name) }}
{%- endfor %}
}

// NewMetricsBuilder returns a builder gated by config. startTime is the process
// start, reported on every cumulative datapoint so a consumer can tell a reset
// from a genuine drop.
func NewMetricsBuilder(config MetricsConfig, startTime pcommon.Timestamp, scopeName, scopeVersion string) *MetricsBuilder {
	mb := &MetricsBuilder{
		config:       config,
		startTime:    startTime,
		scopeName:    scopeName,
		scopeVersion: scopeVersion,
{%- for metric in ctx.metrics %}
		metric{{ go_name(metric.name) }}: metric{{ go_name(metric.name) }}{data: pmetric.NewMetric(), config: config.{{ go_name(metric.name) }}},
{%- endfor %}
	}
{%- for metric in ctx.metrics %}
	mb.metric{{ go_name(metric.name) }}.init()
{%- endfor %}
	return mb
}
{% for metric in ctx.metrics %}
// Record{{ go_name(metric.name) }} records one datapoint of {{ metric.name }}.
//
{{ metric.brief | trim | comment(format="go") }}
{%- if metric.note %}
//
{{ metric.note | trim | comment(format="go") }}
{%- endif %}
//
// Instrument: {{ metric.instrument }}. Unit: {{ metric.unit }}. Stability: {{ metric.stability }}.
func (mb *MetricsBuilder) Record{{ go_name(metric.name) }}(ts pcommon.Timestamp, value {{ value_type(metric) }}{{ attr_params(metric) }}) {
	mb.metric{{ go_name(metric.name) }}.record(mb.startTime, ts, value{% if metric.attributes %}, attrs{% endif %})
}
{% endfor %}
// Emit moves everything recorded since the last call into a pmetric.Metrics
// under resource, leaving the builder empty and ready for the next scrape.
func (mb *MetricsBuilder) Emit(resource pcommon.Resource) pmetric.Metrics {
	md := pmetric.NewMetrics()
	rm := md.ResourceMetrics().AppendEmpty()
	resource.CopyTo(rm.Resource())

	sm := rm.ScopeMetrics().AppendEmpty()
	sm.Scope().SetName(mb.scopeName)
	sm.Scope().SetVersion(mb.scopeVersion)
	ms := sm.Metrics()
{%- for metric in ctx.metrics %}
	mb.metric{{ go_name(metric.name) }}.emit(ms)
{%- endfor %}

	// A scrape that recorded nothing produces no scope and no resource, rather
	// than an empty envelope downstream has to filter out.
	if ms.Len() == 0 {
		return pmetric.NewMetrics()
	}
	return md
}
